# Copy to .env.local and fill in. Never commit .env.local.

# Firebase → Project settings → Your apps → Web app config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Comma-separated e-mails allowed to use /admin (same list as firestore.rules)
ADMIN_EMAILS=admin@projetocaramelo.org.br

# Cloudinary → Dashboard (API secret stays server-side)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
