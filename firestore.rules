rules_version = '2';

// Deploy with `npx firebase-tools deploy --only firestore:rules` (or paste into
// Firebase console → Firestore Database → Rules and publish).
// Keep the e-mail list in sync with ADMIN_EMAILS in .env.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email.lower() in ['admin@projetocaramelo.org.br'];
    }

    // Shown on the public site; only admins edit them.
    match /pets/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public part of a vakinha (with the `raised` total). Donations never go
    // here: they'd be readable by anyone.
    match /vakinhas/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && !('donations' in request.resource.data);
      allow delete: if isAdmin();
    }

    // Donation ledger of each vakinha (same id); admin only.
    match /vakinhaDonations/{id} {
      allow read, write: if isAdmin();
    }
  }
}
